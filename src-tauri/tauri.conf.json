{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveNote",
  "version": "../package.json",
  "identifier": "ru.livenote.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run desktop:web",
      "wait": true
    },
    "beforeBuildCommand": "npm run desktop:web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "macos-titlebar",
          "platforms": ["macOS"],
          "windows": ["main", "vault-*"],
          "local": false,
          "remote": {
            "urls": ["http://127.0.0.1:4317/*"]
          },
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../dist/web/": "web/"
    }
  }
}
