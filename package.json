{
  "name": "livenote",
  "version": "0.1.0",
  "description": "Локальный визуальный блокнот для совместной работы с AI-агентом: страницы из Markdown- и Mermaid-блоков, MCP-инструменты, живое обновление через SSE",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-drawio.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "desktop:web": "node scripts/prepare-drawio.mjs && vite build --mode desktop",
    "tauri": "tauri",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.4.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^12.4.1",
    "bpmn-auto-layout": "^2.0.0-alpha.2",
    "bpmn-js": "^18.31.0",
    "bpmn-moddle": "^10.3.1",
    "bpmnlint": "^11.14.0",
    "express": "^4.21.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.1.0",
    "open": "^10.2.0",
    "playwright": "^1.56.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^24.7.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
